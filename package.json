{
  "name": "roadlimit-uae",
  "version": "0.1.1",
  "private": true,
  "description": "Privacy-first speed-limit awareness for UAE roads.",
  "license": "Apache-2.0",
  "author": "Juber Shaikh and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeWithJuber/roadlimit-uae.git"
  },
  "homepage": "https://github.com/CodeWithJuber/roadlimit-uae#readme",
  "bugs": {
    "url": "https://github.com/CodeWithJuber/roadlimit-uae/issues"
  },
  "keywords": [
    "expo",
    "react-native",
    "android",
    "ios",
    "road-safety",
    "speed-awareness",
    "uae",
    "dubai",
    "privacy"
  ],
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "expo-doctor",
    "repo:check": "node tools/check-repository.mjs",
    "check:data": "vitest run src/data/__tests__/dubaiRoads.test.ts",
    "data:import": "node tools/import-dubai-csv.mjs",
    "check": "npm run typecheck && npm test && npm run repo:check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "expo": "~58.0.13",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-location": "~58.0.17",
    "expo-notifications": "~58.1.5",
    "expo-speech": "~58.0.3",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.9.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.21.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
